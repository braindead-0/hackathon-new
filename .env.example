# Copy to .env to override defaults. No secrets are required to run the prototype.
# All variables use the DHT_ prefix (see backend/app/config.py).

# Database (SQLite by default; any SQLAlchemy URL works, e.g. postgresql+psycopg://user:pass@host/db)
DHT_DATABASE_URL=sqlite:///./data/twin.db

# Seed one synthetic subject with history on first start
DHT_SEED_ON_STARTUP=true
DHT_HISTORY_DAYS=7
DHT_HISTORY_INTERVAL_S=300
DHT_HISTORY_SEED=7
DHT_DEMO_SEED=42

# Live demo pacing: one reading per tick; each tick advances twin time
DHT_TICK_SECONDS=1.0
DHT_TWIN_SECONDS_PER_TICK=15
DHT_AUTOSTART_LIVE=true

# Allowed browser origins for the dev server
DHT_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DHT_LOG_LEVEL=INFO

# Phone connection: address phones should use, if auto-detection is wrong (e.g. in Docker).
# DHT_PUBLIC_URL=http://192.168.1.20:8000
# DHT_PUBLIC_PORT=8000

# --- External API credentials & endpoints (server-only; keep in .env, gitignored) ---
# Twilio WhatsApp. Provide either AUTH_TOKEN or API_KEY+API_SECRET.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VALIDATE_SIGNATURE=false
# Comma-separated WhatsApp recipients (E.164). DRY_RUN=true logs instead of sending.
ALERT_RECIPIENTS=
# Default doctor WhatsApp number for alerts when no clinician has saved one.
CLINICIAN_ALERT_PHONE=
DRY_RUN=true

# Telegram Bot API (official). Optional base override.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_API_BASE=https://api.telegram.org

# Groq clinical Q&A (optional; falls back to the InsForge AI gateway).
GROQ_API_KEY=

# InsForge AI gateway (OpenRouter). Provision via `npx @insforge/cli ai setup` (paid
# plan) or paste a key. Server-only; never expose to the frontend.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# InsForge Storage (server-only admin key). Falls back to .insforge/project.json.
INSFORGE_BASE_URL=
INSFORGE_API_KEY=
# INSFORGE_ANON_KEY=

# HAPI FHIR R4 base URL (local server).
DHT_HAPI_BASE_URL=http://localhost:8090/fhir

# Internal token for device/phone endpoints (optional).
INTERNAL_API_TOKEN=

# Resend report email (server-only; never expose to the frontend).
# Sends the generated report PDF on Generate and the weekly automated report.
# RESEND_FROM must be a verified sender domain or the Resend sandbox address.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
# Fallback recipient when sign-in email is left blank.
DEFAULT_REPORT_EMAIL=shreeharshastark@gmail.com
